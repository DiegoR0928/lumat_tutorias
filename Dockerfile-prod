FROM debian:bookworm-slim

RUN apt-get update && apt-get upgrade -y
RUN apt-get install -y \
    apache2 \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    libmariadb-dev \
    libapache2-mod-wsgi-py3 \
    pkg-config \
    gcc \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz-subset0 \
    libjpeg-dev \
    libopenjp2-7-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

ENV TZ=America/Mexico_City
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Copiamos requirements y código fuente
COPY ./requirements-prod.txt /app/requirements-prod.txt
COPY ./app /app/

WORKDIR /app

RUN python3 -m venv /env
ENV PATH="/env/bin:$PATH"

RUN /env/bin/pip install --upgrade pip
RUN /env/bin/pip install -r /app/requirements-prod.txt

# ARG solo existe durante el build, no queda grabado en la imagen
ARG SECRET_KEY=dummy-secret-key-for-build
ARG DEBUG=False
ARG DB_HOST=localhost
ARG DB_NAME=dummy
ARG DB_USER=dummy
ARG DB_PASSWORD=dummy
ARG ALLOWED_HOSTS=localhost

# manage.py está en /app/lumat_tutorias/
WORKDIR /app/lumat_tutorias
RUN /env/bin/python manage.py collectstatic --no-input

COPY ./lumat.conf /etc/apache2/sites-available/lumat.conf

# Deshabilita el sitio default y habilita el de Django
RUN a2dissite 000-default.conf && \
    a2ensite lumat.conf && \
    a2enmod wsgi

CMD ["apachectl", "-D", "FOREGROUND"]